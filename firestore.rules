rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone may read the site content. Only the one admin account may write.
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }

    // Enquiries dropped by the website form. Write-only for the public.
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['name','phone','space','area','location','message','finish','photos','at'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() < 20;
      allow read, update, delete: if request.auth != null
                   && request.auth.uid == 'PASTE_ADMIN_UID_HERE';
    }

    match /{document=**} { allow read, write: if false; }
  }
}
